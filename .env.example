# Public site URL used for auth redirects, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required together for Supabase mode. Without them, CoupleSync uses a local JSON database in .data/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Newer Supabase projects may name the public key this instead. Either public key works.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this to the browser. Required for Supabase mode.
SUPABASE_SERVICE_ROLE_KEY=

# Optional migration source. With no Supabase credentials, a Blob token keeps one shared JSON copy.
# Run `npm run migrate:supabase` to inspect it, then `npm run migrate:supabase -- --apply` after the three Supabase keys are set.
# The Blob store is left in place until that copy is checked. `npm run migrate:rollback` restores the previous database rows.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Signs local-mode session cookies. Required in production if Supabase Auth is not used.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Resend (https://resend.com). The key starts with re_. Leave it empty to show one-time links on screen.
RESEND_API_KEY=
# Sender on the verified wendev.site domain. onboarding@resend.dev can only mail the Resend account owner.
EMAIL_FROM="wendevNoReply <noreply@wendev.site>"
# Real inbox for the contact form. Addresses ending in .local are not mailed.
CONTACT_EMAIL=

# Comma-separated emails that receive the admin question tools. No shared admin password is shipped.
ADMIN_EMAILS=

# Comma-separated emails for the super admin role. Super admins open the user list, create accounts, and impersonate.
# Demo addresses are ignored. In local mode, SUPER_ADMIN_PASSWORD creates the first operator when that email has no profile.
SUPER_ADMIN_EMAILS=
SUPER_ADMIN_PASSWORD=

# Password for the fictional seed couple, Maya Chen and Jordan Reyes. At least 8 characters.
# The first boot creates them. Later boots update their password to this value. They are not administrators.
DEMO_PASSWORD=

# Set to true after Google is enabled in the Supabase Auth dashboard.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Cycle predictions stay inside CoupleSync unless both of these are set and the user opts in.
# CYCLE_PREDICTION_PROVIDER=local
# CYCLE_PREDICTION_API_KEY=
# CYCLE_PREDICTION_API_URL=https://api.apiverve.com/v1/menstrualcycle
